# Copy this file to config.env and fill it in. config.env is never committed to git.

# Shared password for the two of you. Use something long.
APP_PASSWORD=change-me-to-something-long

# The public address Tailscale Funnel gives you (no trailing slash).
PUBLIC_URL=https://your-laptop.your-tailnet.ts.net

# Only accept connections from this machine; Tailscale Funnel forwards the outside traffic.
HOST=127.0.0.1
PORT=3000

# Name of the calendar in Apple Calendar.
CALENDAR_NAME=Meals

# Where the database lives (relative to this folder, or a full path).
# DATA_DIR=data

# Nightly backups (see scripts/backup.js). A OneDrive folder gives you an off-machine copy for free.
# BACKUP_DIR=C:\Users\you\OneDrive\BlevingPlanner-backups
# BACKUP_KEEP=30
